<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#0B1F3A">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:paddingTop="35dp"
        android:paddingBottom="40dp">

        <FrameLayout
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/fondo_circular"
            android:clipToOutline="true"
            android:clipChildren="true">

            <ImageView
                android:id="@+id/imgLogo"
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:layout_gravity="center"
                android:src="@drawable/dormitorio_login"
                android:scaleType="centerCrop"
                android:contentDescription="Dormitorio iluminado" />

        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Iniciar sesión"
            android:textColor="#FFFFFF"
            android:textSize="30sp"
            android:textStyle="bold"
            android:layout_marginBottom="35dp" />

        <EditText
            android:id="@+id/etCorreoLogin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Correo electrónico"
            android:inputType="textEmailAddress"
            android:maxLength="50"
            android:textColor="#FFFFFF"
            android:textColorHint="#D9E3F0"
            android:backgroundTint="#FFFFFF"
            android:padding="12dp"
            android:layout_marginBottom="22dp" />

        <EditText
            android:id="@+id/etContrasenaLogin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Contraseña"
            android:inputType="textPassword"
            android:maxLength="15"
            android:digits="abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"
            android:textColor="#FFFFFF"
            android:textColorHint="#D9E3F0"
            android:backgroundTint="#FFFFFF"
            android:padding="12dp"
            android:layout_marginBottom="12dp" />

        <CheckBox
            android:id="@+id/cbRecordarme"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Recordarme"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:buttonTint="#FFFFFF"
            android:layout_marginBottom="28dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnIniciarSesion"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Ingresar"
            android:textAllCaps="false"
            android:textColor="#0B1F3A"
            android:textSize="17sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp"
            app:backgroundTint="#FFFFFF"
            app:cornerRadius="30dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnIrRegistro"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="¿No tienes cuenta? Regístrate"
            android:textAllCaps="false"
            android:textColor="#0B1F3A"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="#FFFFFF"
            app:cornerRadius="30dp" />

    </LinearLayout>

</ScrollView>