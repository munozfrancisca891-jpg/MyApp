
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Permiso para conectarse a Firebase -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".ControlLuzApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="Control de Luz"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyApp">

        <!-- Pantalla de presentación: se abre primero -->
        <activity
            android:name=".splashActivity"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- Inicio de sesión -->
        <activity
            android:name=".LoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Pantalla principal de bienvenida -->
        <activity
            android:name=".BienvenidaActivity"
            android:exported="false" />

        <!-- Control de encendido y apagado -->
        <activity
            android:name=".ControlLuzActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Registros de iluminación -->
        <activity
            android:name=".MainActivity"
            android:exported="false" />

        <!-- Preferencias -->
        <activity
            android:name=".PreferenciasActivity"
            android:exported="false" />

        <!-- Registro de usuarios -->
        <activity
            android:name=".RegistroActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

    </application>

</manifest>
